# --- App ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# Replace both placeholders in your untracked local .env before using Postgres.
DATABASE_URL=postgresql+asyncpg://<DATABASE_USER>:<DATABASE_PASSWORD>@db:5432/aegisai
# For local SQLite dev:
# DATABASE_URL=sqlite+aiosqlite:///./aegisai.db

# --- Auth ---
JWT_SECRET=<GENERATE_A_MINIMUM_32_CHARACTER_RANDOM_SECRET>
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Anthropic ---
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
CLAUDE_WORKING_MODEL=claude-sonnet-5
CLAUDE_JUDGE_MODEL=claude-opus-4-7
CLAUDE_TIMEOUT_S=12
CLAUDE_MAX_RETRIES=0
OCR_TIMEOUT_S=10
OCR_MAX_DIMENSION=4096

# --- Tier thresholds ---
TIER2_THRESHOLD=0.75
SESSION_JAILBREAK_THRESHOLD=0.7

# --- Rate limits ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_INSPECT_PER_MIN=60

# --- Seeding ---
# Set SEED_ADMIN_PASSWORD only in your untracked local .env before seeding.
# It is intentionally omitted from this committed example file.
