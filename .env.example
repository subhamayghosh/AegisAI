# --- App ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://promptshield:promptshield@db:5432/promptshield
# For local SQLite dev:
# DATABASE_URL=sqlite+aiosqlite:///./promptshield.db

# --- Auth ---
JWT_SECRET=change-me-to-a-32-byte-random-string
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
CLAUDE_WORKING_MODEL=claude-sonnet-5
CLAUDE_JUDGE_MODEL=claude-opus-4-7
CLAUDE_TIMEOUT_S=12
CLAUDE_MAX_RETRIES=0

# --- Tier thresholds ---
TIER2_THRESHOLD=0.75
SESSION_JAILBREAK_THRESHOLD=0.7

# --- Rate limits ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_INSPECT_PER_MIN=60

# --- Seeding ---
SEED_ADMIN_PASSWORD=AdminChangeMe123!
